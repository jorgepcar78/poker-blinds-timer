{
  "name": "poker-blinds-timer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test \"tests/*.test.js\"",
    "preview:cf": "npm run build && wrangler pages dev dist",
    "db:create": "wrangler d1 create poker-blinds-timer",
    "db:migrate:local": "wrangler d1 migrations apply poker-blinds-timer --local",
    "db:migrate": "wrangler d1 migrations apply poker-blinds-timer --remote"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "tailwindcss": "^4.2.4",
    "vite": "^8.0.9",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "^4.151.3"
  }
}
